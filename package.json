{
  "name": "lazy-changelog",
  "version": "1.0.0",
  "description": "You write bad commits. We get it. lazy-changelog reads your code anyway and writes a proper changelog for you.",
  "license": "MIT",
  "author": "QuickFlo",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuickFlo/lazy-changelog.git"
  },
  "keywords": [
    "changelog",
    "release",
    "ai",
    "cli",
    "git",
    "nx",
    "anthropic",
    "openai",
    "google",
    "ollama",
    "release-notes",
    "semantic-release"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "lazy-changelog": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "commit": "node ./dist/cli.js commit",
    "commit:run": "node ./dist/cli.js commit -e",
    "changelog": "node ./dist/cli.js generate --diffs --model claude-sonnet-4-20250514 --prepend CHANGELOG.md",
    "release": "pnpm run build && pnpm run changelog && pnpm version",
    "release:patch": "pnpm run build && pnpm version patch && pnpm run changelog:version",
    "release:minor": "pnpm run build && pnpm version minor && pnpm run changelog:version",
    "release:major": "pnpm run build && pnpm version major && pnpm run changelog:version",
    "changelog:version": "node ./dist/cli.js generate --diffs --model claude-sonnet-4-20250514 --tag \"v$(node -p \"require('./package.json').version\")\" --prepend CHANGELOG.md"
  },
  "peerDependencies": {
    "nx": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    }
  },
  "dependencies": {
    "ai": "^6.0.39",
    "commander": "^12.0.0"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/openai": "^3.0.12",
    "ollama-ai-provider": "^1.2.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/openai": "^3.0.12",
    "@types/node": "^22.15.34",
    "nx": "^21.5.1",
    "ollama-ai-provider": "^1.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
